# OS/editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Keil temporary and user-local files
*.tmp
*.bak
*.uvgui.*
*.uvguix.*
*.uvgui_*
*.uvguix_*

# Keil generated intermediates
**/Listings/
**/Objects/*
!**/Objects/*.hex
**/MDK-ARM/*/*.axf
**/MDK-ARM/*/*.build_log.htm
**/MDK-ARM/*/*.dep
**/MDK-ARM/*/*.d
**/MDK-ARM/*/*.htm
**/MDK-ARM/*/*.lnp
**/MDK-ARM/*/*.map
**/MDK-ARM/*/*.o
!**/MDK-ARM/*/*.hex

# Proteus user-local/autosave files
*.workspace
*.pdsprj.*.workspace
**/Project Backups/

# Visual Studio user/build files
**/.vs/
**/bin/
**/obj/
*.user
*.suo

# Keep source, project dependencies, archives, and simulation firmware trackable:
# - *.c, *.h, *.s
# - *.uvproj, *.uvprojx, *.uvopt, *.uvoptx, *.ioc
# - *.pdsprj, *.dsn
# - *.csproj, *.sln, *.slnx
# - *.zip original submissions
# - *.hex when needed by a simulation
